{
  "name": "@nityaranjan190592/pw-common-framework",
  "version": "1.0.1",
  "description": "Open Cart Playwright Framework",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/",
    "src/pages/",
    "src/fixtures/",
    "src/api/",
    "src/utils/",
    "src/types/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npx playwright test",
    "test:headed": "npx playwright test --headed",
    "test:chrome": "npx playwright test --project=chromium",
    "allure:history": "node scripts/prepare-allure-history.ts",
    "allure:generate": "npx allure generate allure-results --clean -o allure-report",
    "allure:open": "npx allure open allure-report",
    "allure:report": "npm run allure:history && npm run allure:generate && npm run allure:open",
    "allure:clean": "rimraf allure-results allure-report",
    "clean:allreports": "rimraf reporting-labs allure-results allure-report all-blob-reports blob-report blob1-report blob2-report blob3-report blob4-report reports test-results"
  },
  "keywords": [
    "playwright",
    "typescript",
    "pom",
    "automation",
    "testing",
    "sdet",
    "api-testing",
    "data-driven",
    "framework"
  ],
  "author": "Nitya Ranjan <nityaranjan190592@gmail.com>",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/Nitya-Testing/PW-FRAMEWORK",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nitya-Testing/PW-FRAMEWORK"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.64.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.14.0",
    "rimraf": "^6.1.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.9",
    "reporting-labs": "^0.6.24",
    "xlsx": "^0.18.5"
  }
}
